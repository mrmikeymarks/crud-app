# Copy to .env (git-ignored) and edit. Compose reads .env automatically.
# Every setting is explained in README.md ("Configuration").

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
API_PORT=3000

# Absolute host path for the Postgres data files. Must exist before the first start.
PGDATA_DIR=/home/mike/docker/data/crud-app/pgdata

# Dev-only GUIs (Adminer :8080, NocoDB :8081). 127.0.0.1 = this machine only.
GUI_BIND_ADDR=127.0.0.1

# Only used by the optional Caddy gateway (disabled by default).
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: bcrypt hashes contain `$`.
#GUI_AUTH_USER=admin
#GUI_AUTH_HASH='$2a$14$replace-me'
