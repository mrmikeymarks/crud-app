# Copy to `.env` (which is git-ignored) and change the password.
# Compose reads .env automatically; nothing else needs to reference it.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
API_PORT=3000
# Host directory that holds the Postgres data files (must exist before first start)
PGDATA_DIR=/home/mike/docker/data/crud-app/pgdata
# Host address the dev-only GUIs (Adminer :8080, NocoDB :8081) listen on.
# 127.0.0.1 = this machine only. Use your LAN or VPN IP to reach them from other devices.
GUI_BIND_ADDR=127.0.0.1
