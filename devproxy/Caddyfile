# Optional dev gateway: basic auth in front of Adminer (:8080) and NocoDB (:8081).
# Enabled by uncommenting `devproxy` in compose.override.yaml. See README.md.
{
	admin off
	auto_https off
}

(auth) {
	basic_auth {
		{$GUI_AUTH_USER} {$GUI_AUTH_HASH}
	}
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		import auth
		reverse_proxy adminer:8080
	}
}

:8081 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		import auth
		reverse_proxy nocodb:8080
	}
}
