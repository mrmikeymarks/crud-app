# Dev-only gateway. The ONLY container that publishes the GUI ports on the host.
# Everything behind it (Adminer, NocoDB) has no `ports:` at all, so the login
# below is the sole way in. Credentials come from GUI_AUTH_USER / GUI_AUTH_HASH
# in .env; Caddy substitutes {$VAR} placeholders at startup.
{
	admin off # no Caddy admin API listening inside the container
	auto_https off # plain HTTP on a LAN IP; see README for enabling TLS
}

# Reusable snippet: HTTP Basic Auth against the bcrypt hash from .env
(auth) {
	basic_auth {
		{$GUI_AUTH_USER} {$GUI_AUTH_HASH}
	}
}

# ---- Adminer on host port 8080 ----
:8080 {
	handle /healthz {
		# unauthenticated, used by the Docker healthcheck only
		respond "ok" 200
	}
	handle {
		import auth
		reverse_proxy adminer:8080
	}
}

# ---- NocoDB on host port 8081 ----
:8081 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		import auth
		reverse_proxy nocodb:8080 # websockets are proxied automatically
	}
}
